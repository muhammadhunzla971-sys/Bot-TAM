# Copy this file to .env.local for local development, and add the same
# variables in Vercel: Project -> Settings -> Environment Variables.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Optional Groq configuration (used as fallback, or preferred with AI_PROVIDER=groq).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
